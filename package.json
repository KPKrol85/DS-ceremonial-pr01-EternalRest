{
  "name": "eternal-rest",
  "version": "1.0.0",
  "private": true,
  "description": "Eternal Rest multi-page funeral home demo website built with Vite, CSS and vanilla JavaScript",
  "author": "Kamil Król — KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KPKrol85/DS-ceremonial-pr01-EternalRest.git"
  },
  "homepage": "https://ds-ceremonial-pr01-eternalrest.netlify.app/",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "npm run build && playwright test --project=chromium",
    "test:cross-browser": "npm run build && playwright test --project=firefox --project=webkit",
    "test:a11y": "npm run build && playwright test --config=playwright.a11y.config.js",
    "audit:performance": "npm run build && node scripts/audit-performance.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"js/**/*.js\"",
    "check:references": "node scripts/check-references.js",
    "images:convert": "node scripts/convert-images.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "8.57.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "fast-glob": "^3.3.2",
    "globals": "13.24.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
